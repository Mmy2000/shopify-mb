  -webkit-font-feature-settings: "liga" 1, "kern" 1, "calt" 1, "init" 1, "medi" 1, "fina" 1, "isol" 1;
  text-align: right;
  white-space: normal;
  word-break: break-word;
  overflow-wrap: break-word;
  font-variant-ligatures: common-ligatures;
}
.cert .cell.ar.value-only { justify-content: flex-start; }
.cert .cell .label { color: #1a1814; font-weight: 500; }
.cert .cell .value { color: #1a1814; }
.cert .cell.ar .value,
.cert .cell.ar .label {
  direction: rtl;
  unicode-bidi: embed;
  font-family: 'Amiri', 'Noto Naskh Arabic', 'Geeza Pro', 'Arial', serif;
  text-align: right;
  white-space: normal;
  word-break: break-word;
  overflow-wrap: break-word;
}

.cert .iso-line {
