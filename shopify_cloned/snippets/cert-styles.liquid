  display: flex;
  flex-direction: column;
}

.cert .header { text-align: center; display: flex; flex-direction: column; align-items: center; }

.cert .logo {
  width: 260px;
  height: 170px;
  display: block;
  object-fit: contain;
  object-position: center;
}

.cert .title-bar {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 16px;
  margin-top: 8px;
}
.cert .title-bar .rule {
  width: 140px;
  height: 1px;
  flex: none;
}
.cert .title-bar .rule.left  { background: linear-gradient(to right, transparent 0%, #5d574a 100%); }
.cert .title-bar .rule.right { background: linear-gradient(to left,  transparent 0%, #5d574a 100%); }
.cert .title-bar .title {
