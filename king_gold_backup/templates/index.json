      "settings": {
        "custom_liquid": "<div class=\"ig-section\">\n\n<div class=\"ig-header\">\n<h2>Stay Connected</h2>\n<p>\nSee How Our Gold Jewelry is Styled & Worn.\nFollow us on Instagram\n</p>\n</div>\n\n<div class=\"ig-grid\">\n\n<div class=\"ig-card\">\n<video autoplay muted loop playsinline>\n<source src=\"https://cdn.shopify.com/videos/c/o/v/3ddcdf50e57b4db3b1f83225930c96a7.mp4\" type=\"video/mp4\">\n</video>\n</div>\n\n<div class=\"ig-card\">\n<video autoplay muted loop playsinline>\n<source src=\"https://cdn.shopify.com/videos/c/o/v/c157dd426c924ca4b61900a853bc4521.mp4\" type=\"video/mp4\">\n</video>\n</div>\n\n<div class=\"ig-card\">\n<video autoplay muted loop playsinline>\n<source src=\"https://cdn.shopify.com/videos/c/o/v/ca9efedf3e264505bd52cc05ff9bd24c.mp4\" type=\"video/mp4\">\n</video>\n</div>\n\n<div class=\"ig-card\">\n<video autoplay muted loop playsinline>\n<source src=\"https://cdn.shopify.com/videos/c/o/v/58c22a870c84488892448a656212eabc.mp4\" type=\"video/mp4\">\n</video>\n</div>\n\n</div>\n\n</div>\n\n<style>\n\n.ig-section{\npadding:60px 0;\n}\n\n.ig-header{\ntext-align:center;\nmax-width:700px;\nmargin:auto;\nmargin-bottom:40px;\n}\n\n.ig-header h2{\nfont-size:34px;\nmargin-bottom:10px;\n}\n\n.ig-header p{\nfont-size:16px;\ncolor:#666;\n}\n\n.ig-grid{\ndisplay:grid;\ngrid-template-columns:repeat(4,1fr);\ngap:20px;\n}\n\n.ig-card{\nposition:relative;\noverflow:hidden;\nborder-radius:px;\n}\n\n.ig-card video{\nwidth:100%;\nheight:420px;\nobject-fit:cover;\ntransition:0.4s;\n}\n\n.ig-card:hover video{\ntransform:scale(1.05);\n}\n\n@media(max-width:900px){\n.ig-grid{\ngrid-template-columns:repeat(2,1fr);\n}\n}\n\n@media(max-width:600px){\n.ig-grid{\ngrid-template-columns:1fr;\n}\n}\n\n</style>",
